{
  "name": "bello",
  "version": "0.1.0",
  "description": "Bello – Privacy-Spürhund: prüft, ob das Consent-Management einer Website Drittverbindungen vor/ohne Einwilligung verhindert.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "k1tesurfen",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "bello": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "data",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'test/smoke/**'",
    "test:smoke": "vitest run test/smoke",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "license:check": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow \"MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;MPL-2.0;0BSD;CC0-1.0;BlueOak-1.0.0;Python-2.0\" --summary"
  },
  "dependencies": {
    "@duckduckgo/autoconsent": "16.48.0",
    "commander": "^15.0.0",
    "maxmind": "^5.0.7",
    "picocolors": "^1.1.1",
    "playwright": "1.64.0",
    "tldts": "^7.4.18",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
